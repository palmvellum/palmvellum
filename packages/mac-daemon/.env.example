# PalmVellum Mac daemon — environment configuration.
# Copy to .env (gitignored) and fill in values.

# Supabase project (production)
SUPABASE_URL=https://jrkwncplngmznfzzqwee.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_UoFQ7p6EPTm0cbqimURGPQ_J1HO_aR-

# CRITICAL — get this from Supabase Studio → Settings → API → Secret keys.
# NEVER commit this. NEVER paste into Slack/Discord/screenshots.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# User context — populated by the enrollment flow.
USER_ID=00000000-0000-0000-0000-000000000000
DEVICE_ID=mac-$(hostname)

# AI provider selection — "openai" (default) or "anthropic".
AI_PROVIDER=openai

# OpenAI (default backend)
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini

# Anthropic (alternate backend — only used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Local state.
SQLITE_PATH=~/.local/share/palmvellum/cache.db
HTTP_ADDR=127.0.0.1:7733
LOG_LEVEL=info

# palm-sync sidecar — stays in stub until the FTDI cable arrives.
PALMSYNC_MODE=stub
PALMSYNC_SOCKET=~/.local/share/palmvellum/palm-sync.sock

# Palm enrollment — paste the 64-char token from PWA Settings → "enroll a Palm".
# The daemon trades it for your user_id on startup via resolve_hotsync_token.
PALMVELLUM_HOTSYNC_TOKEN=
