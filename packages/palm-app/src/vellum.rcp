// Vellum Capture v1.2 — resource definitions for prc-tools/pilrc.
//
// Two forms:
//   1000 = main capture (tabs + body field + save + sync banner +
//          up to 5 clickable record rows as NOFRAME buttons)
//   1100 = entry detail (read or EDIT body + answer + save/del/done/back)
//
// The log List widget from v1.0/v1.1 is gone. Each record row is now
// its own NOFRAME LEFTANCHOR button so a tap fires ctlSelectEvent
// rather than lstSelectEvent, which avoids the known PalmOS quirk
// where FrmGotoForm from inside lstSelectEvent could trip up the list
// widget's own redraw pass.

FORM ID 1000 AT (0 0 160 160)
USABLE
BEGIN
    TITLE "Vellum"

    PUSHBUTTON "AI"      ID 1001 AT (4   18 38 14) GROUP 1
    PUSHBUTTON "thought" ID 1002 AT (46  18 56 14) GROUP 1
    PUSHBUTTON "todo"    ID 1003 AT (106 18 50 14) GROUP 1

    FIELD ID 1010 AT (4 38 152 28)
        MULTIPLELINES UNDERLINED EDITABLE MAXCHARS 1024 AUTOSHIFT

    BUTTON "save" ID 1020 AT (4 70 36 14)
    LABEL "" ID 1021 AT (46 72) FONT 0

    GRAFFITISTATEINDICATOR AT (140 70)

    // Pending banner: "log" when 0 pending, "log : N to sync" otherwise.
    // Initial text reserves bbox width for the longest practical message.
    LABEL "log : 99 to sync" ID 1022 AT (4 90) FONT 0

    // Five clickable record rows. NOFRAME + LEFTANCHOR makes them
    // look like plain text lines but they still fire ctlSelectEvent
    // when tapped anywhere in their 152x11 rect. Hidden by default;
    // RebuildList() shows the ones with content.
    BUTTON "" ID 1200 AT (4 102 152 11) NOFRAME LEFTANCHOR FONT 0 NONUSABLE
    BUTTON "" ID 1201 AT (4 114 152 11) NOFRAME LEFTANCHOR FONT 0 NONUSABLE
    BUTTON "" ID 1202 AT (4 126 152 11) NOFRAME LEFTANCHOR FONT 0 NONUSABLE
    BUTTON "" ID 1203 AT (4 138 152 11) NOFRAME LEFTANCHOR FONT 0 NONUSABLE
    BUTTON "" ID 1204 AT (4 150 152 10) NOFRAME LEFTANCHOR FONT 0 NONUSABLE
END

FORM ID 1100 AT (0 0 160 160)
USABLE
BEGIN
    TITLE "entry"

    LABEL "" ID 1101 AT (4 18) FONT 0      // type chip e.g. "AI"
    LABEL "" ID 1102 AT (90 18) FONT 0     // status e.g. "draft"

    FIELD ID 1110 AT (4 32 152 54)
        MULTIPLELINES UNDERLINED EDITABLE MAXCHARS 1024 AUTOSHIFT

    LABEL "answer" AUTOID AT (4 90) FONT 1
    FIELD ID 1111 AT (4 100 152 40)
        MULTIPLELINES UNDERLINED MAXCHARS 1024

    GRAFFITISTATEINDICATOR AT (140 18)

    BUTTON "save"   ID 1123 AT (4   146 36 12)
    BUTTON "delete" ID 1121 AT (44  146 38 12)
    BUTTON "done"   ID 1122 AT (86  146 32 12)
    BUTTON "back"   ID 1120 AT (122 146 36 12)
END
