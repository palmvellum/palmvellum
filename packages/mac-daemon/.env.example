# PalmVellum Mac daemon — environment configuration.
# Copy to .env (gitignored) and fill in values. The daemon reads from
# the OS environment; .env is loaded only if it sits beside the binary
# or in $HOME/.config/palmvellum/.env.

# Supabase project.
# Use the NEW key format (sb_publishable_xxx / sb_secret_xxx) — legacy
# anon / service_role keys sunset end of 2026.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# User context — populated by the enrollment flow.
USER_ID=00000000-0000-0000-0000-000000000000
DEVICE_ID=mac-$(hostname)

# Anthropic for the AI worker.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Local state.
SQLITE_PATH=~/.local/share/palmvellum/cache.db
HTTP_ADDR=127.0.0.1:7733
LOG_LEVEL=info

# palm-sync sidecar (Node). Set to "stub" until the cradle hardware
# arrives; the daemon will simulate sync events without touching real
# serial ports.
PALMSYNC_MODE=stub
PALMSYNC_SOCKET=~/.local/share/palmvellum/palm-sync.sock
