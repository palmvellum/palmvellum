# Copy to .env and source it before running ./bin/vellum-sync
#   cp .env.example .env
#   source .env
#
# Then drop a VellumDB.pdb backup from CloudpilotEmu and run:
#   ./bin/vellum-sync push VellumDB.pdb
#   ./bin/vellum-sync pull -out new.pdb
#
# .env is git-ignored — never commit your service-role key.

export SUPABASE_URL=https://jrkwncplngmznfzzqwee.supabase.co
export SUPABASE_SERVICE_ROLE_KEY=<paste service_role key from Supabase Dashboard → Settings → API>
